# Server Configuration
PORT=8080
ENV=development

# Supabase PostgreSQL Database URL
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Redis Configuration (Local dev default port: 6739)
REDIS_HOST=localhost
REDIS_PORT=6739
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting Defaults (requests per minute)
RATE_LIMIT_PUBLIC_RPM=120
RATE_LIMIT_SEARCH_RPM=60
RATE_LIMIT_ADMIN_RPM=30
